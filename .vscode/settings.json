{
    "Slingshot.readFileLineLimit": 3000,
    "slingshot.agent.compaction.enabled": true,
    "slingshot.agent.environmentVariables": {
        "COMPACTION_ENABLED": "true"
    },
    "terminal.integrated.env.windows": {
        "COMPACTION_ENABLED": "true"
    },
    "Slingshot.enablePromptRecommendationInSmartChat": true,
    "Slingshot.enableAtTheRateWorkspaceFeature": true,
    "Slingshot.enableECGMcpServer": true,
    "Slingshot.enableLogs": true,
    "Slingshot.atTheRateWorkspaceIgnoredFilePatterns": [
        "SellerAccount.java"
    ],
    "Slingshot.atTheRateWorkspaceInclusionFilePatterns": [
        ".vscode/settings.json"
    ],
    "Slingshot.enableAutomaticCreationOfFilesWithFilenameClick": true
}
